{
  "name": "game-note-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "docker run -d --rm --name game-note-test-db -e POSTGRES_PASSWORD=test -e POSTGRES_DB=game_note_test -p 54329:5432 postgres:17-alpine",
    "import:firestore": "tsx scripts/import-firestore.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "firebase-admin": "^14.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
