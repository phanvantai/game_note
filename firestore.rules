rules_version = '2';

// Since 5.0.0 the app stores everything on the Game Note API (server/);
// Firestore keeps the pre-migration snapshot only. It is read-only so a
// 4.x client still installed somewhere fails loudly instead of writing
// data the new backend would never see.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
